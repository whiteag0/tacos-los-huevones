# ============================================
# TACOS LOS HUEVONES - BACKEND ENVIRONMENT
# ============================================
# Copy this file to .env for local development
# For Render: Set these in Dashboard > Environment

# ------------------------------------------
# SUPABASE (Database)
# Get from: supabase.com/dashboard > Settings > API
# ------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key  # Use service_role, NOT anon

# ------------------------------------------
# SQUARE PAYMENTS
# Get from: developer.squareup.com/apps
# ------------------------------------------
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-location-id
SQUARE_APPLICATION_ID=your-app-id
SQUARE_ENVIRONMENT=sandbox  # Use "production" when live

# ------------------------------------------
# TWILIO (SMS Notifications)
# Get from: console.twilio.com
# ------------------------------------------
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------
# RESEND (Email Notifications)
# Get from: resend.com/api-keys
# ------------------------------------------
RESEND_API_KEY=re_xxxxx

# ------------------------------------------
# BUSINESS CONTACT (receives notifications)
# ------------------------------------------
BUSINESS_PHONE=+1234567890
BUSINESS_EMAIL=orders@tacosloshuevones.com

# ------------------------------------------
# FRONTEND URL (your Vercel deployment)
# ------------------------------------------
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# ADMIN API KEY
# Generate with: openssl rand -hex 32
# ------------------------------------------
ADMIN_API_KEY=your-secret-admin-key
